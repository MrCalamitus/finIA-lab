# Plantilla de configuración. Copia a .env y llena tus valores. Nunca versiones .env.
# Detalle: specs/001-asistente-finanzas-whatsapp/contracts/configuracion.md

# Id del grupo de WhatsApp. Se obtiene con: npm run grupos
FINIA_GROUP_JID=120363000000000000@g.us

# Ollama: solo localhost o una IP de red privada
FINIA_OLLAMA_URL=http://127.0.0.1:11434
FINIA_OLLAMA_MODEL=nombre-del-modelo
FINIA_LLM_TIMEOUT_MS=20000

# Fotos de tickets: modelo con capacidad "vision". Vacío = usar FINIA_OLLAMA_MODEL.
FINIA_OLLAMA_MODEL_VISION=
FINIA_VISION_TIMEOUT_MS=60000

FINIA_AUTH_DIR=./auth_info
FINIA_DB_PATH=./data/finia.db
FINIA_LOG_LEVEL=info

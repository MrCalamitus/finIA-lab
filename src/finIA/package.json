{
  "name": "finia",
  "version": "0.1.0",
  "description": "Asistente de finanzas personales por WhatsApp con LLM local",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/main.ts",
    "grupos": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/scripts/grupos.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "eval": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env eval/correr.ts"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  }
}
